PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siahssr_db
# Set to "true" for most managed/hosted MySQL providers (Railway, Aiven,
# PlanetScale, ...) — they require TLS. Leave unset/false for local MySQL.
DB_SSL=false

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# This server now serves the frontend itself (../frontend-html), so
# CLIENT_URL should just be this server's own address/port — the same
# place you open in a browser to use the site.
CLIENT_URL=http://localhost:5000

# Email (verification links, password resets). Without this filled in, links
# are only logged to this server's console instead of actually being emailed.
#
# To use Gmail:
#   1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
#   2. Create an App Password: myaccount.google.com/apppasswords
#      (pick "Mail" as the app) — this gives you a 16-character password.
#   3. Use that App Password below as SMTP_PASS — NOT your normal Gmail password,
#      Google blocks normal-password logins from apps like this.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=siahssr05@gmail.com
SMTP_PASS=
SMTP_FROM=SIAHSSR <siahssr05@gmail.com>
